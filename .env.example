# ==============================================================================
# EcoPulse Environment Configuration
# ==============================================================================
# This file defines the environment configuration for EcoPulse backend & frontend.
# Copy this file to .env and configure your credentials.
#
# EcoPulse operates gracefully with zero required keys:
# - Map Renderer: Automatically defaults to Open Satellite Engine (ESRI / CartoDB)
#                 with zero tokens required. Mapbox 3D Globe is optionally supported.
# - GEE Telemetry: Supports GEE_API_KEY, Service Account, or synthetic fallback.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Earth Engine (GEE) / Google Cloud API Key
# ------------------------------------------------------------------------------
GEE_API_KEY=
GEE_PROJECT=
GEE_SERVICE_ACCOUNT=
GEE_CREDENTIALS_PATH=./secrets/gee_credentials.json

# ------------------------------------------------------------------------------
# 2. Mapbox GL Access Token (Optional)
# ------------------------------------------------------------------------------
# Optional: Public Mapbox token (starts with pk.).
# If left empty, the Open Satellite Engine (Leaflet + ESRI World Imagery) runs automatically.
MAPBOX_TOKEN=

# ------------------------------------------------------------------------------
# 3. Machine Learning Model Weights (Optional)
# ------------------------------------------------------------------------------
MODEL_WEIGHTS_PATH=./backend/weights/unet_burn.h5

# ------------------------------------------------------------------------------
# 4. Backend Server Settings
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*
ECOPULSE_API_BASE=http://localhost:8000
