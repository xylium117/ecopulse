# ==============================================================================
# EcoPulse Environment Configuration
# ==============================================================================
# This file defines the environment configuration for EcoPulse backend & frontend.
# Copy this file to .env and configure your credentials.
#
# EcoPulse operates gracefully with zero required keys:
# - Map Renderer: Dual-Engine UI with 2D Open Satellite Engine (Leaflet + ESRI/CartoDB)
#                 and 3D Planetary WebGL Globe (Globe.gl + Three.js) - 100% token-free!
# - GEE Telemetry: Live Google Earth Engine (Service Account JSON or Cloud Project).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Earth Engine (GEE) / Google Cloud Configuration
# ------------------------------------------------------------------------------
GEE_API_KEY=
GEE_PROJECT=tidy-elf-448805-k4
GEE_SERVICE_ACCOUNT=ecopulse-gee-sa@tidy-elf-448805-k4.iam.gserviceaccount.com
GEE_CREDENTIALS_PATH=./secrets/gee_credentials.json

# ------------------------------------------------------------------------------
# 3. Machine Learning Model Weights (Optional)
# ------------------------------------------------------------------------------
MODEL_WEIGHTS_PATH=./backend/weights/unet_burn.h5

# ------------------------------------------------------------------------------
# 4. Backend Server Settings
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*
ECOPULSE_API_BASE=http://localhost:8000
